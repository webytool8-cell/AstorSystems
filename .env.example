# Public base URL used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.astorsystems.com

# --- Inquiry delivery (configure at least one in production) ---
# Supabase: inquiries are inserted into the `inquiries` table (see supabase/migrations).
# The service role key is used server-side only and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional webhook (e.g. an n8n or Make webhook) that receives each inquiry as JSON.
INQUIRY_WEBHOOK_URL=
# Optional shared secret sent as the X-Astor-Signature header (HMAC-SHA256 of the body).
INQUIRY_WEBHOOK_SECRET=

# --- AI intake chat (/start) ---
# Anthropic API key for the intake assistant. Without it, /start shows a fallback message.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5).
ASTOR_CHAT_MODEL=

# --- Firebase Authentication (required to use the chat) ---
# Web app config from Firebase console → Project settings → Your apps. These are public identifiers.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side token verification uses the project ID (defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=

# Local development only (ignored in production): use the Firebase Auth emulator.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
