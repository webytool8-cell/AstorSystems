# Public base URL used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.astorsystems.com

# --- Inquiry delivery (configure at least one in production) ---
# Supabase: inquiries are inserted into the `inquiries` table (see supabase/migrations).
# The service role key is used server-side only and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional webhook (e.g. an n8n or Make webhook) that receives each inquiry as JSON.
INQUIRY_WEBHOOK_URL=
# Optional shared secret sent as the X-Astor-Signature header (HMAC-SHA256 of the body).
INQUIRY_WEBHOOK_SECRET=
